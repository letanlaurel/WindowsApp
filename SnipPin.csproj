<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标（Explorer/任务栏/窗口） -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AssemblyName>TLSnipPin</AssemblyName>
    <RootNamespace>SnipPin</RootNamespace>
    <Version>0.1.0</Version>
    <Description>TLSnipPin - Windows 截图贴图工具</Description>
    <!-- 允许不安全代码（部分 Win32 互操作需要） -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- 单文件发布相关 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 单文件压缩：大幅减小体积，首次启动略慢（运行时解压到内存），功能无影响 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图标作为嵌入资源（窗口 Icon 与托盘加载用） -->
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 依赖注入 / 日志 / 配置 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <!-- WPF 托盘图标（成熟开源组件） -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <!-- 本地离线 OCR（onnxruntime 推理，PP-OCRv5 中文模型见 Assets\models） -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- OCR 模型四件套（det/cls/rec/字典）：显式 Target 复制（Content 在 publish 下只带出部分文件，不可靠） -->
    <OcrModelFiles Include="Assets\models\zh\**\*.*" />
  </ItemGroup>

  <!-- 开发调试：模型复制到输出目录，运行时按 exe 旁 models\zh 查找 -->
  <Target Name="CopyOcrModelsBuild" AfterTargets="Build">
    <Copy SourceFiles="@(OcrModelFiles)" DestinationFolder="$(TargetDir)models\zh\" SkipUnchangedFiles="true" />
  </Target>

  <!-- 发布：模型复制到发布目录 exe 旁（同 RapidOcrNet.targets 的模式） -->
  <Target Name="CopyOcrModelsPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(OcrModelFiles)" DestinationFolder="$(PublishDir)models\zh\" SkipUnchangedFiles="true" />
  </Target>

  <!-- RapidOcrNet 的 nuget targets 会把自带 latin 模型复制到发布目录 models\v5（约 21MB，本项目不用），
       依赖其内部 Target 名 CopyModelsPublish，升级包版本时需复核此 Target 是否仍存在 -->
  <Target Name="RemoveUnusedLatinModels" AfterTargets="CopyModelsPublish">
    <RemoveDir Directories="$(PublishDir)models\v5\" />
  </Target>

</Project>
